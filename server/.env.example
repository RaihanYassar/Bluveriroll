# BLUVERIROLL Backend Environment Variables Template

# Application Port & Environment
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL / Supabase)
# Opsi 1: URI Connection String Supabase (Recommended)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Opsi 2: Konfigurasi manual PostgreSQL lokal jika tidak menggunakan DATABASE_URL
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_NAME=bluveriroll_dev
DB_HOST=127.0.0.1
DB_PORT=5432

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# Third-party Integrations (Backend Only)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GOOGLE_CLIENT_ID=496985110038-bqr7glv9gtba59qsbo0ief9r4upe806p.apps.googleusercontent.com
JIKAN_API_BASE_URL=https://api.jikan.moe/v4

