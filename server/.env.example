# BLUVERIROLL Backend Environment Variables Template

# Application Port & Environment
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Local PostgreSQL Fallback
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bluveriroll_dev
DB_HOST=127.0.0.1
DB_PORT=5432

# Authentication & Security
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Third-party Integrations (Backend Only)
OPENAI_API_KEY=sk-proj-your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
JIKAN_API_BASE_URL=https://api.jikan.moe/v4

