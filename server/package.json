{
  "name": "bluveriroll-server",
  "version": "1.0.0",
  "description": "BLUVERIROLL Backend API - AI-Powered Movie & Anime Discovery Platform",
  "main": "bin/www.js",
  "scripts": {
    "start": "node bin/www.js",
    "dev": "nodemon bin/www.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:setup": "sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": [
    "bluveriroll",
    "movie",
    "anime",
    "express",
    "sequelize",
    "hacktiv8"
  ],
  "author": "Raihan Yassar",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.18.0",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "sqlite3": "^5.1.7",
    "supertest": "^7.2.2"
  }
}
